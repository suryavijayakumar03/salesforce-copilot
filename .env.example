ANTHROPIC_API_KEY=sk-ant-...your-key-here...
PORT=3000

# Password buyers type to unlock paid access. Use a long random phrase (12+ characters).
# Paid access stays off until this is set; the free sample still works.
PAID_ACCESS_CODE=change-me-to-a-long-random-phrase

# Optional usage limits (defaults shown). Daily counters reset at 00:00 UTC.
# FREE_QUESTIONS_PER_EMAIL=3
# FREE_PER_IP_PER_DAY=5
# PAID_PER_IP_PER_DAY=30
# FREE_DAILY_LIMIT=20
# GLOBAL_DAILY_LIMIT=60
# MAX_QUESTION_CHARS=2000
# FAILED_CODES_PER_IP_PER_DAY=15
# DATA_DIR=./data
